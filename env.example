# =========================================
# YouTube (nécessaire pour voir les vidéos YT)
# =========================================
YT_API_KEY=XXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
YT_CHANNEL_ID=UCxxxxxxxxxxxxxxxxxxxxxxx

# OAuth YouTube
YOUTUBE_CLIENT_ID=your-youtube-client-id
YOUTUBE_CLIENT_SECRET=your-youtube-client-secret
YOUTUBE_REDIRECT_URI=https://social-hub.fr/api/auth/callback/youtube
YOUTUBE_SCOPES=https://www.googleapis.com/auth/youtube.readonly

# =========================================
# TikTok
# =========================================
ENABLE_TIKTOK=1
TIKTOK_USERNAME=usernameSans@
TIKTOK_CLIENT_KEY=your-tiktok-client-key
TIKTOK_CLIENT_SECRET=your-tiktok-client-secret
TIKTOK_REDIRECT_URI=https://social-hub.fr/api/auth/callback/tiktok
TIKTOK_SCOPES=user.info.basic,video.list

# =========================================
# Instagram
# =========================================
INSTAGRAM_CLIENT_ID=your-instagram-client-id
INSTAGRAM_CLIENT_SECRET=your-instagram-client-secret
INSTAGRAM_REDIRECT_URI=https://social-hub.fr/api/auth/callback/instagram
INSTAGRAM_SCOPES=user_profile,user_media

# =========================================
# Facebook
# =========================================
FACEBOOK_APP_ID=your-facebook-app-id
FACEBOOK_APP_SECRET=your-facebook-app-secret
FACEBOOK_REDIRECT_URI=https://social-hub.fr/api/auth/callback/facebook
FACEBOOK_SCOPES=public_profile,email,pages_show_list

# =========================================
# Matomo (mesure d'audience, chargé uniquement après consentement)
# =========================================
NEXT_PUBLIC_MATOMO_URL=https://stats.social-hub.fr
NEXT_PUBLIC_MATOMO_SITE_ID=1
# Conteneur Matomo Tag Manager (laisser vide pour ne pas le charger)
NEXT_PUBLIC_MATOMO_CONTAINER=https://stats.social-hub.fr/js/container_MEycDz8y.js

# =========================================
# Optionnel
# =========================================
NEXT_PUBLIC_BASE_URL=https://social-hub.fr
