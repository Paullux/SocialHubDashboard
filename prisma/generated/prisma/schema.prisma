datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
  output   = "./generated/prisma"
}

model OAuthToken {
  provider     String // "tiktok"
  userId       String // ton user interne (ex: "me" pour démarrer)
  openId       String
  accessToken  String
  refreshToken String
  scope        String
  expiresAt    BigInt
  updatedAt    DateTime @default(now())

  @@id([provider, userId])
  @@index([expiresAt])
}
