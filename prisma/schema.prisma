// prisma/schema.prisma
datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")   // pooled
  directUrl = env("DATABASE_URL_UNPOOLED")     // direct
}

generator client {
  provider = "prisma-client-js"
}

/**
 * ========= EXISTANT =========
 */

/**
 * ========= NOUVEAU =========
 */

model VideoMetric {
  platform   String
  videoId    String
  snapshotAt DateTime
  views      BigInt   @default(0)
  likes      BigInt   @default(0)
  comments   BigInt   @default(0)
  shares     BigInt?

  @@id([platform, videoId, snapshotAt])
  @@index([platform, videoId, snapshotAt])
}

/**
 * ===== CATALOGUE (cache des tris) =====
 * Toutes les vidéos publiques d'un compte lié, avec leurs compteurs, pour que
 * les tris par vues / likes / commentaires portent sur tout le catalogue et
 * pas seulement sur les dernières vidéos chargées. Reconstruit par le cron
 * quand une nouvelle vidéo apparaît (ou quand le cache vieillit).
 */

model VideoCatalog {
  userId        String
  platform      String
  sourceId      String   // chaîne YouTube au moment du calcul
  latestVideoId String?  // vidéo la plus récente : en changer = reconstruire
  items         Json     // VideoItem[]
  refreshedAt   DateTime
  // Construction en plusieurs passages (TikTok, jusqu'à 3 000 vidéos) : les
  // pages déjà lues et le curseur de reprise. null = aucune en cours.
  pendingItems  Json?
  pendingCursor String?

  @@id([userId, platform])
}

/**
 * ======= ACCOUNT LINKED =======
 */

model AccountLink {
  id              String   @id @default(cuid())
  userId          String
  provider        String
  externalUserId  String
  username        String?
  accessTokenEnc  String
  refreshTokenEnc String?
  scope           String
  expiresAt       DateTime?
  meta            Json?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([userId, provider])
  @@index([userId])
  @@index([externalUserId])
}

