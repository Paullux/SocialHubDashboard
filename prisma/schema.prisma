// prisma/schema.prisma
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

/* ========= EXISTANT ========= */

model OAuthToken {
  provider     String   // "tiktok"
  userId       String   // ton user interne (ex: "me")
  openId       String
  accessToken  String
  refreshToken String
  scope        String
  expiresAt    BigInt
  updatedAt    DateTime @default(now())

  @@id([provider, userId])
  @@index([expiresAt])
}

/* ========= NOUVEAU ========= */

model VideoMetric {
  platform    String
  videoId     String
  snapshotAt  DateTime
  views       BigInt   @default(0)
  likes       BigInt   @default(0)
  comments    BigInt   @default(0)
  shares      BigInt?

  @@id([platform, videoId, snapshotAt])
  @@index([platform, videoId, snapshotAt])
}

